{
  "name": "budgetier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "start": "docker-compose up",
    "start:web": "docker-compose up web",
    "start:api": "docker-compose up api",
    "build": "docker-compose -f docker-compose.prod.yml build",
    "prod": "docker-compose -f docker-compose.prod.yml up",
    "web:dev": "npm run dev --workspace=web",
    "web:build": "npm run build --workspace=web",
    "web:lint": "npm run lint --workspace=web"
  },
  "devDependencies": {
    "prettier": "3.7.4"
  }
}